---
import type { LocaleContent } from '../data/site';

interface Props {
  copy: LocaleContent;
}

const { copy } = Astro.props;
const timeline = copy.timeline;
---

<section class="section" id="trajetoria" aria-labelledby="trajetoria-title">
  <div class="shell">
    <h2 class="section-title" id="trajetoria-title">
      <span class="index">{timeline.index}</span>
      {timeline.title}
    </h2>
    <p class="section-lead">{timeline.lead}</p>
    <ol class="timeline">
      {
        timeline.items.map((item) => (
          <li>
            <p class="when">{item.period}</p>
            <div class:list={['event', { 'is-placeholder': item.placeholder }]}>
              <p class="kind">{item.type === 'education' ? timeline.education : timeline.experience}</p>
              <h3>{item.title}</h3>
              <p class="org">{item.org}</p>
              <p>{item.summary}</p>
              {item.placeholder && <p class="tag">{timeline.placeholder}</p>}
              {item.href && item.linkLabel && (
                <p>
                  <a class="text-link" href={item.href} target="_blank" rel="noopener noreferrer">
                    {item.linkLabel}
                    <span class="sr-only"> ({copy.openNewTab})</span>
                  </a>
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
