---
import { profile, type LocaleContent } from '../data/site';

interface Props {
  copy: LocaleContent;
}

const { copy } = Astro.props;
---

<section class="hero" id="inicio" aria-labelledby="inicio-title">
  <div class="shell hero-grid">
    <div>
      <p class="kicker">01 · {copy.hero.kicker} · {profile.location}</p>
      <h1 id="inicio-title">{profile.role}</h1>
      <p class="bio">{copy.hero.bio}</p>
      {copy.hero.bioNote && <p class="placeholder-note">{copy.hero.bioNote}</p>}
      <div class="actions">
        {
          profile.availableForProjects && (
            <a class="button button-status" href="/#contato">
              {copy.availability}
            </a>
          )
        }
        <a class="button button-primary" href={profile.github.url} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.56 9.56 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
          {copy.github}
          <span class="sr-only">({copy.openNewTab})</span>
        </a>
        <a class="button" href={profile.linkedin.url} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45C23.2 24 24 23.23 24 22.27V1.73C24 .77 23.2 0 22.23 0z"
            ></path>
          </svg>
          {copy.linkedin}
          <span class="sr-only">({copy.openNewTab})</span>
        </a>
        {
          profile.cvUrl ? (
            <a class="button" href={profile.cvUrl}>
              {copy.cv}
            </a>
          ) : (
            <button class="button" type="button" disabled>
              {copy.cv}
              <span class="button-hint">{copy.cvSoon}</span>
            </button>
          )
        }
      </div>
    </div>
    <figure class="portrait">
      <img
        src={profile.avatarUrl}
        alt={`Foto de ${profile.name}`}
        width="461"
        height="461"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </div>
</section>
